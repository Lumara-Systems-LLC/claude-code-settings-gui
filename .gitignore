# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/
.idea/
*.swp
*~

# logs (catch-all)
*.log

# Claude Code project config
# Commit:    .claude/CLAUDE.md, .claude/settings.json
# Don't commit personal allowlists, memory, plans, cached state
.claude/settings.local.json
.claude/memory/
.claude/plans/
.claude/.cache/
.claude/cache/
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/session-env/
